  "required": ["profile"],
  "properties": {
    "profile": { "type": "string", "minLength": 1 },
    "verbose": { "type": "boolean" },
    "unmuted": { "type": "boolean" },
    "extra": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
