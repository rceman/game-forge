{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "game-forge://ops/visual.pixel/input",
  "type": "object",
  "required": ["points"],
  "properties": {
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "items": { "type": "integer", "minimum": 0 },
        "minItems": 2,
        "maxItems": 2
      }
    },
    "case": { "type": "string" },
    "ticks": { "type": "integer", "minimum": 0 },
    "seed": { "type": "string" },
    "world": { "type": "string" },
    "region": { "type": "string" },
    "image": { "type": "string" },
    "out": { "type": "string" }
  },
  "additionalProperties": false
}
